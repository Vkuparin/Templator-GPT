<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Templator.Core\Templator.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets/Templator.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <Product>Templator</Product>
    <Description>A local workspace for reusable email drafts.</Description>
  </PropertyGroup>

</Project>
