<Window x:Class="Templator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Templator.Views"
        Title="Templator — a little less repetition" Style="{StaticResource {x:Type Window}}" Width="1360" Height="880" MinWidth="1050" MinHeight="680"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="OnShortcut" Closing="OnClosing">
    <Window.Resources>
        <DataTemplate x:Key="VariableCard">
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,0,0,15" Margin="0,0,10,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,9">
                        <Button DockPanel.Dock="Right" Content="Edit" Click="EditVariable" Tag="{Binding}" Style="{StaticResource Quiet}" Padding="5,6" FontSize="11" ToolTip="Rename, set a hint, or delete this variable"/>
                        <Button Tag="{Binding}" Click="InsertVariable" PreviewMouseLeftButtonDown="ChipMouseDown" PreviewMouseMove="ChipMouseMove"
                                Padding="9,5" HorizontalAlignment="Left" Background="#294438" BorderBrush="#4B6B56" Foreground="{StaticResource Accent}"
                                ToolTip="Drag into your email, or click to insert at the cursor" AutomationProperties.Name="{Binding Label}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⠿" Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding Label}" FontSize="12" MaxWidth="165" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                <TextBlock Text=" *" FontSize="12" Visibility="{Binding Required, Converter={StaticResource Visible}}"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding Example}" AutomationProperties.Name="{Binding Label}"
                             AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto" FontSize="13"/>
                    <TextBlock Text="Not in this email yet · drag to insert" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,7,0,0">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Referenced}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Background="{StaticResource Canvas}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <Grid Margin="18,26,18,18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="6,0,0,30">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="29" Height="29" CornerRadius="7" Background="{StaticResource Accent}" Margin="0,0,10,0"><TextBlock Text="t." Foreground="#15291F" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-3,0,0"/></Border>
                        <TextBlock Text="templator" FontSize="23" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Text="A LITTLE LESS REPETITION" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/>
                </StackPanel>
                <TextBox x:Name="SearchBox" Grid.Row="1" Tag="Search templates   Ctrl+F" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Margin="0,0,0,20" AutomationProperties.Name="Search templates"/>
                <DockPanel Grid.Row="2" Margin="4,0,0,12">
                    <Button x:Name="NewButton" DockPanel.Dock="Right" Content="+ New" Padding="9,6" Click="NewTemplate" ToolTip="New template · Ctrl+N"/>
                    <TextBlock Text="YOUR LIBRARY" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0"/>
                </DockPanel>
                <ListBox x:Name="TemplateList" Grid.Row="3" ItemsSource="{Binding Library}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Template library">
                    <ListBox.ContextMenu><ContextMenu><MenuItem Header="Duplicate" Click="Duplicate"/><MenuItem Header="Move up" Click="MoveUp"/><MenuItem Header="Move down" Click="MoveDown"/><Separator/><MenuItem Header="Delete…" Click="DeleteTemplate"/></ContextMenu></ListBox.ContextMenu>
                    <ListBox.ItemTemplate><DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Margin="0,9,0,0">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="English · Email template"/><Style.Triggers><DataTrigger Binding="{Binding Language}" Value="fi"><Setter Property="Text" Value="Suomi · Email template"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="4">
                    <Separator/>
                    <UniformGrid Columns="2"><Button Content="Import" Style="{StaticResource Quiet}" Click="Import"/><Button Content="Export" Style="{StaticResource Quiet}" Click="Export"/></UniformGrid>
                    <Button Content="Settings" Style="{StaticResource Quiet}" Click="Settings"/>
                    <TextBlock Text="●  Local workspace" Foreground="{StaticResource Accent}" FontSize="11" Margin="10,20,0,0"/>
                    <TextBlock Text="{Binding SaveStatus}" Foreground="{StaticResource Muted}" FontSize="11" Margin="10,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="26,24,26,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,22">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding HasSelection}">
                    <Button Content="Duplicate" Style="{StaticResource Quiet}" Click="Duplicate"/>
                    <Button Content="Delete" Style="{StaticResource Quiet}" Click="DeleteTemplate"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="MAKE YOURSELF AT HOME" Style="{StaticResource Eyebrow}" Margin="2,0,0,4"/>
                    <TextBox x:Name="NameEditor" Text="{Binding Selected.Name, UpdateSourceTrigger=PropertyChanged}" Tag="Your next email starts here" FontSize="24" FontWeight="SemiBold"
                             Background="Transparent" BorderThickness="0" Padding="2,4" IsEnabled="{Binding HasSelection}" AutomationProperties.Name="Template name" ToolTip="Click to rename your template"/>
                </StackPanel>
            </DockPanel>
            <Border Grid.Row="1" Background="#27382F" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Notice}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <DockPanel><Button DockPanel.Dock="Right" Content="Dismiss" Style="{StaticResource Quiet}" Click="DismissNotice"/><TextBlock Text="{Binding Notice}" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/></DockPanel>
            </Border>
            <Grid Grid.Row="2">
                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasSelection}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*" MinWidth="330"/></Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <Button x:Name="AddVariableButton" DockPanel.Dock="Right" Content="+ New" Click="AddVariable" Padding="10,6" ToolTip="Create a reusable variable"/>
                        <TextBlock Text="Variables" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="Drag a name into your email. Fill its value below, or click a chip on the page." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,8,20"/>
                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="ValueInputs" ItemsSource="{Binding Selected.Variables}" ItemTemplate="{StaticResource VariableCard}"/></ScrollViewer>
                        <StackPanel Margin="8,24,8,0" VerticalAlignment="Top">
                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Selected.Variables.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                            <TextBlock Text="A name. A value. Anywhere." FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <TextBlock Text="Create a variable for a detail you reuse, like a customer or an order number. Then drag it into place." Foreground="{StaticResource Muted}" FontSize="12"/>
                            <Button Content="+ Create your first variable" Click="AddVariable" Margin="0,20,0,0"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="3" Margin="0,10,10,0">
                        <TextBlock Text="{Binding Progress}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,8"/>
                        <Button x:Name="ResetVariablesButton" Content="Reset to variable names" Click="ResetValues" IsEnabled="{Binding HasValues}" FontSize="12"
                                ToolTip="Clear this template's filled values and show the variable names again. You can undo this reset."/>
                        <Button x:Name="UndoResetButton" Content="Undo reset" Click="UndoReset" Style="{StaticResource Quiet}" FontSize="12"
                                Visibility="{Binding CanUndoReset, Converter={StaticResource Visible}}"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,5,0,14">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <RadioButton x:Name="EnglishRadio" Content="English" GroupName="Language" Checked="LanguageChanged" FontSize="11" Margin="0,0,12,0"/>
                            <RadioButton x:Name="FinnishRadio" Content="Suomi" GroupName="Language" Checked="LanguageChanged" FontSize="11" Margin="0"/>
                        </StackPanel>
                        <TextBlock Text="YOUR EMAIL  /  CLICK TO EDIT" Style="{StaticResource Eyebrow}" Margin="0" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border Grid.Row="1" Background="#F4F2EB" CornerRadius="9" Padding="24,22">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0" PreviewDragOver="ScrollWhileDragging">
                                <StackPanel>
                                    <TextBlock Text="EMAIL DRAFT" Foreground="#65756C" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,16"/>
                                    <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="To" Foreground="#66736B" FontSize="12" Margin="0,10,0,0"/><views:TokenEditor x:Name="ToEditor" Grid.Column="1" SingleLine="True" FontSize="13" AutomationProperties.Name="To" ToolTip="Type recipients, or drop a variable here"/></Grid>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Cc" Foreground="#66736B" FontSize="12" Margin="0,10,0,0"/><views:TokenEditor x:Name="CcEditor" Grid.Column="1" SingleLine="True" FontSize="13" AutomationProperties.Name="Cc" ToolTip="Type optional recipients, or drop a variable here"/></Grid>
                                    <TextBlock Text="SUBJECT" Foreground="#65756C" FontSize="10" Margin="0,20,0,2"/>
                                    <views:TokenEditor x:Name="SubjectEditor" SingleLine="True" FontSize="20" FontWeight="SemiBold" AutomationProperties.Name="Subject" ToolTip="Write your subject here. Variables work here too."/>
                                    <TextBlock Text="MESSAGE" Foreground="#65756C" FontSize="10" Margin="0,20,0,4"/>
                                    <Grid>
                                        <views:TokenEditor x:Name="BodyEditor" MinHeight="210" BorderThickness="0" AutomationProperties.Name="Message" ToolTip="Write and edit your message here. Drop variables between words."/>
                                        <TextBlock Text="Write your message here…" Foreground="#859084" FontSize="15" Margin="7,10,0,0" IsHitTestVisible="False" VerticalAlignment="Top">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Selected.Body}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                            <TextBlock Grid.Row="1" Text="Prepared here. Sent by you." Foreground="#66766A" FontSize="11" Margin="0,16,0,0"/>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="2" Text="Edits update this template automatically. Variable chips become plain text in your mail app." Foreground="{StaticResource Muted}" FontSize="11" Margin="2,12,0,0"/>
                </Grid>
            </Grid>
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="410">
                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasSelection}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                <TextBlock Text="A good email, on repeat." FontSize="28" FontWeight="SemiBold" TextAlignment="Center"/>
                <TextBlock Text="Create a template or choose one from your library. Write directly on the page, then add reusable details." Foreground="{StaticResource Muted}" TextAlignment="Center" Margin="0,16,0,24"/>
                <Button Content="+ Create a template" Style="{StaticResource Primary}" Click="NewTemplate" HorizontalAlignment="Center"/>
            </StackPanel>
            <Grid Grid.Row="3" Margin="0,18,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="{Binding Validation}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
                <DockPanel Grid.Row="1">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Copy body" Click="CopyBody" IsEnabled="{Binding HasSelection}" Style="{StaticResource Quiet}"/>
                        <Button Content="Copy full text" Click="CopyFull" IsEnabled="{Binding HasSelection}" Style="{StaticResource Quiet}" Margin="4,0,14,0"/>
                        <Button x:Name="OpenDraftButton" Content="Open draft  ↗" Click="OpenDraft" IsEnabled="{Binding HasSelection}" Style="{StaticResource Primary}" ToolTip="Open the current email in your mail app. Repeat after any edits · Ctrl+Enter" MinWidth="146"/>
                    </StackPanel>
                    <TextBlock Text="{Binding DraftStatus}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
