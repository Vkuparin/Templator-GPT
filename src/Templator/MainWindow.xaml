<Window x:Class="Templator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Templator.Views"
        Title="Templator — a little less repetition" Style="{StaticResource {x:Type Window}}" Width="1360" Height="880" MinWidth="1050" MinHeight="680"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="OnShortcut" Closing="OnClosing">
    <Window.Resources>
        <DataTemplate x:Key="InputRow">
            <StackPanel Margin="0,0,10,9">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                    <TextBlock Text="{Binding Label}" FontWeight="Medium"/>
                    <TextBlock Text=" *" Foreground="{StaticResource Accent}" Visibility="{Binding Required, Converter={StaticResource Visible}}"/>
                </StackPanel>
                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding Example}" AutomationProperties.Name="{Binding Label}"
                         AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto"/>
                <TextBlock Text="Not used in this template" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,5,0,0">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Referenced}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="DefinitionRow">
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource Quiet}" Click="DeleteVariable" Tag="{Binding}" ToolTip="Remove definition and saved value"/>
                        <TextBlock Text="{Binding Key}" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="Display label" Style="{StaticResource Caption}"/>
                    <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Variable display label"/>
                    <TextBlock Text="Example hint" Style="{StaticResource Caption}" Margin="0,10,0,6"/>
                    <TextBox Text="{Binding Example, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Variable example hint"/>
                    <CheckBox Content="Required" IsChecked="{Binding Required}"/>
                    <TextBlock Text="Unreferenced · retained for later" FontSize="11" Foreground="{StaticResource Muted}">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Referenced}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Background="{StaticResource Canvas}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <Grid Margin="18,26,18,18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="6,0,0,30">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="29" Height="29" CornerRadius="7" Background="{StaticResource Accent}" Margin="0,0,10,0">
                            <TextBlock Text="t." Foreground="#15291F" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-3,0,0"/>
                        </Border>
                        <TextBlock Text="templator" FontSize="23" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Text="A LITTLE LESS REPETITION" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/>
                </StackPanel>
                <TextBox x:Name="SearchBox" Grid.Row="1" Tag="Search templates   Ctrl+F" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Margin="0,0,0,20" AutomationProperties.Name="Search templates"/>
                <DockPanel Grid.Row="2" Margin="4,0,0,12">
                    <Button x:Name="NewButton" DockPanel.Dock="Right" Content="+ New" Padding="9,6" Click="NewTemplate" ToolTip="New template · Ctrl+N"/>
                    <TextBlock Text="YOUR LIBRARY" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0"/>
                </DockPanel>
                <ListBox x:Name="TemplateList" Grid.Row="3" ItemsSource="{Binding Library}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Template library">
                    <ListBox.ContextMenu><ContextMenu><MenuItem Header="Duplicate" Click="Duplicate"/><MenuItem Header="Move up" Click="MoveUp"/><MenuItem Header="Move down" Click="MoveDown"/><Separator/><MenuItem Header="Delete…" Click="DeleteTemplate"/></ContextMenu></ListBox.ContextMenu>
                    <ListBox.ItemTemplate><DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Subject}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Language}" Foreground="{StaticResource Accent}" FontSize="10" Margin="0,9,0,0"/>
                        </StackPanel>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="4">
                    <Separator/>
                    <UniformGrid Columns="2"><Button Content="Import" Style="{StaticResource Quiet}" Click="Import"/><Button Content="Export" Style="{StaticResource Quiet}" Click="Export"/></UniformGrid>
                    <Button Content="Settings" Style="{StaticResource Quiet}" Click="Settings" HorizontalContentAlignment="Left"/>
                    <TextBlock Text="●  Local workspace" Foreground="{StaticResource Accent}" FontSize="11" Margin="10,20,0,0"/>
                    <TextBlock Text="{Binding SaveStatus}" Foreground="{StaticResource Muted}" FontSize="11" Margin="10,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="30,26,30,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,20">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding HasSelection}">
                    <Button Content="Duplicate" Style="{StaticResource Quiet}" Click="Duplicate"/>
                    <Button Content="Delete" Style="{StaticResource Quiet}" Click="DeleteTemplate"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="MAIL, MADE REPEATABLE" Style="{StaticResource Eyebrow}"/>
                    <TextBlock Text="{Binding Selected.Name, TargetNullValue=Your next email starts here}" FontSize="25" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
            <Border Grid.Row="1" Background="#27382F" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Notice}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <DockPanel><Button DockPanel.Dock="Right" Content="Dismiss" Style="{StaticResource Quiet}" Click="DismissNotice"/><TextBlock Text="{Binding Notice}" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/></DockPanel>
            </Border>
            <Grid Grid.Row="2">
                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasSelection}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*" MinWidth="275"/><ColumnDefinition Width="28"/><ColumnDefinition Width="1.15*" MinWidth="300"/></Grid.ColumnDefinitions>
                <TabControl x:Name="ModeTabs" SelectedIndex="{Binding EditorMode}">
                    <TabItem Header="Compose">
                        <Grid TextElement.Foreground="{StaticResource Ink}">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Make it yours." FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="1" Text="Fill in the details. Your preview updates as you type." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,22"/>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="ValueInputs" ItemsSource="{Binding Selected.Variables}" ItemTemplate="{StaticResource InputRow}"/></ScrollViewer>
                            <DockPanel Grid.Row="3" Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="Reset values" Style="{StaticResource Quiet}" Click="ResetValues"/><TextBlock Text="{Binding Progress}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/></DockPanel>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Edit template">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,10,0" TextElement.Foreground="{StaticResource Ink}">
                                <TextBlock Text="Build once. Reuse often." FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Text="Use {{variables}} anywhere in the message." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,22"/>
                                <TextBlock Text="Template name" Style="{StaticResource Caption}"/>
                                <TextBox x:Name="NameEditor" Text="{Binding Selected.Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Template name"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                                    <RadioButton x:Name="EnglishRadio" Content="English" GroupName="Language" Checked="LanguageChanged"/>
                                    <RadioButton x:Name="FinnishRadio" Content="Suomi" GroupName="Language" Checked="LanguageChanged"/>
                                </StackPanel>
                                <TextBlock Text="To" Style="{StaticResource Caption}"/><TextBox Text="{Binding Selected.To, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="To template"/>
                                <TextBlock Text="Cc" Style="{StaticResource Caption}" Margin="0,12,0,6"/><TextBox Text="{Binding Selected.Cc, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Cc template"/>
                                <TextBlock Text="Subject" Style="{StaticResource Caption}" Margin="0,12,0,6"/><TextBox x:Name="SubjectEditor" Text="{Binding Selected.Subject, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AutomationProperties.Name="Subject template"/>
                                <TextBlock Text="Message" Style="{StaticResource Caption}" Margin="0,12,0,6"/>
                                <TextBox x:Name="BodyEditor" Text="{Binding Selected.Body, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="230" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="12" VerticalContentAlignment="Top" AutomationProperties.Name="Message template"/>
                                <Separator/>
                                <TextBlock Text="Variable definitions" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Text="Typing a placeholder creates its field automatically. Customize it below, or add one for later." Style="{StaticResource Caption}"/>
                                <DockPanel Margin="0,6,0,0"><Button DockPanel.Dock="Right" Content="Add" Click="AddVariable" Margin="8,0,0,0"/><TextBox Text="{Binding NewKey, UpdateSourceTrigger=PropertyChanged}" Tag="new_variable" AutomationProperties.Name="New variable key"/></DockPanel>
                                <ItemsControl ItemsSource="{Binding Selected.Variables}" ItemTemplate="{StaticResource DefinitionRow}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
                <Grid Grid.Column="2" Margin="0,0,0,4">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,11,0,22">
                        <TextBlock DockPanel.Dock="Right" Text="LIVE PREVIEW" Foreground="{StaticResource Accent}" FontSize="10"/>
                        <TextBlock Text="02  /  REVIEW" Style="{StaticResource Eyebrow}" Margin="0"/>
                    </DockPanel>
                    <Border Grid.Row="1" Background="#F4F2EB" CornerRadius="9" Padding="28,26">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                            <StackPanel>
                            <StackPanel>
                                <TextBlock Text="EMAIL DRAFT" Foreground="#65756C" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,24"/>
                                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="To" Foreground="#66736B" FontSize="12"/><TextBlock Grid.Column="1" Text="{Binding Draft.To}" Foreground="#334139" FontSize="12"/></Grid>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Cc" Foreground="#66736B" FontSize="12"/><TextBlock Grid.Column="1" Text="{Binding Draft.Cc}" Foreground="#334139" FontSize="12"/></Grid>
                            </StackPanel>
                            <Border Height="1" Background="#D7DCD3" Margin="0,22,0,20"/>
                            <TextBlock Text="{Binding Draft.Subject}" Foreground="#24352B" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,22"/>
                            <views:PreviewText x:Name="BodyPreview" AutomationProperties.Name="Rendered message preview"/>
                            </StackPanel>
                            </ScrollViewer>
                            <TextBlock Grid.Row="1" Text="Prepared here. Sent by you." Foreground="#66766A" FontSize="11" Margin="0,22,0,0"/>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="2" Text="Your mail app opens for a final review. Nothing is sent automatically." Foreground="{StaticResource Muted}" FontSize="11" Margin="2,14,0,0"/>
                </Grid>
            </Grid>
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="410">
                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasSelection}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                <TextBlock Text="A good email, on repeat." FontSize="28" FontWeight="SemiBold" TextAlignment="Center"/>
                <TextBlock Text="Create a template or choose one from your library. The repetitive parts are taken care of." Foreground="{StaticResource Muted}" TextAlignment="Center" Margin="0,16,0,24"/>
                <Button Content="+ Create a template" Style="{StaticResource Primary}" Click="NewTemplate" HorizontalAlignment="Center"/>
            </StackPanel>
            <Grid Grid.Row="3" Margin="0,20,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="{Binding Validation}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
                <DockPanel Grid.Row="1">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Copy body" Click="CopyBody" IsEnabled="{Binding HasSelection}" Style="{StaticResource Quiet}"/>
                        <Button Content="Copy full text" Click="CopyFull" IsEnabled="{Binding HasSelection}" Style="{StaticResource Quiet}" Margin="4,0,14,0"/>
                        <Button x:Name="OpenDraftButton" Content="Open draft  ↗" Click="OpenDraft" IsEnabled="{Binding CanOpen}" Style="{StaticResource Primary}" ToolTip="Review in your mail app · Ctrl+Enter" MinWidth="146"/>
                    </StackPanel>
                    <TextBlock Text="{Binding DraftStatus}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
